/**index.wxss**/
.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #aaa;
  width: 80%;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.usermotto {
  margin-top: 200px;
}

.avatar-wrapper {
  padding: 0;
  width: 56px !important;
  border-radius: 8px;
  margin-top: 40px;
  margin-bottom: 40px;
}

.avatar {
  display: block;
  width: 56px;
  height: 56px;
}

.nickname-wrapper {
  display: flex;
  width: 100%;
  padding: 16px;
  box-sizing: border-box;
  border-top: .5px solid rgba(0, 0, 0, 0.1);
  border-bottom: .5px solid rgba(0, 0, 0, 0.1);
  color: black;
}

.nickname-label {
  width: 105px;
}

.nickname-input {
  flex: 1;
}

/* 基础样式 */
.bg-blue-500 {
  background-color: #3b82f6;
}

.bg-white {
  background-color: #fff;
}

.bg-transparent {
  background-color: transparent;
}

.bg-gray-50 {
  background-color: #f9fafb;
}

.text-white {
  color: #fff;
}

.text-blue-500 {
  color: #3b82f6;
}

.text-gray-800 {
  color: #1f2937;
}

.text-gray-600 {
  color: #4b5563;
}

.text-gray-500 {
  color: #6b7280;
}

/* 文本大小 */
.text-xl {
  font-size: 20px;
}

.text-lg {
  font-size: 18px;
}

.text-base {
  font-size: 16px;
}

.text-sm {
  font-size: 14px;
}

/* 字体粗细 */
.font-bold {
  font-weight: 700;
}

.font-semibold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

/* 内边距 */
.p-4 {
  padding: 16px;
}

.px-4 {
  padding-left: 16px;
  padding-right: 16px;
}

.py-2 {
  padding-top: 8px;
  padding-bottom: 8px;
}

.py-3 {
  padding-top: 12px;
  padding-bottom: 12px;
}

/* 外边距 */
.mx-4 {
  margin-left: 16px;
  margin-right: 16px;
}

.my-4 {
  margin-top: 16px;
  margin-bottom: 16px;
}

.mt-4 {
  margin-top: 16px;
}

.mb-2 {
  margin-bottom: 8px;
}

.mb-4 {
  margin-bottom: 16px;
}

/* 布局 */
.flex {
  display: flex;
}

.space-x-4 > view:not(:first-child) {
  margin-left: 16px;
}

.grid {
  display: grid;
}

.grid-cols-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.gap-4 {
  gap: 16px;
}

/* 边框 */
.border {
  border-width: 1px;
  border-style: solid;
}

.border-white {
  border-color: #fff;
}

.border-b {
  border-bottom-width: 1px;
  border-bottom-style: solid;
}

.border-gray-200 {
  border-color: #e5e7eb;
}

/* 圆角 */
.rounded-lg {
  border-radius: 8px;
}

.rounded-full {
  border-radius: 9999px;
}

/* 其他 */
.shadow-md {
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

.overflow-hidden {
  overflow: hidden;
}

.block {
  display: block;
}

/* 页面容器 */
.page-container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 页面标题区域 */
.header {
  padding: 30rpx 0;
  margin-bottom: 30rpx;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 按钮区域 */
.button-area {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.primary-button {
  flex: 1;
  background-color: #3a7eff;
  color: white;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 8rpx;
  margin-right: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 8rpx rgba(58, 126, 255, 0.2);
}

.secondary-button {
  flex: 1;
  background-color: #ffffff;
  color: #3a7eff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #e0e0e0;
}

/* 服务卡片区域 */
.card {
  background-color: #fff;
  border-radius: the 10rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
}

.view-more {
  font-size: 26rpx;
  color: #3a7eff;
}

/* 服务网格 */
.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.service-item {
  background-color: #f9f9f9;
  padding: 24rpx;
  border-radius: 8rpx;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: all 0.3s;
}

.service-item:active {
  background-color: #f0f0f0;
}

.service-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.service-desc {
  font-size: 24rpx;
  color: #666;
}

/* 页脚 */
.footer {
  margin-top: auto;
  text-align: center;
  padding: 40rpx 0 20rpx;
  font-size: 26rpx;
  color: #999;
}
