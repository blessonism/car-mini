<!--index.wxml-->
<view class="page-container">
  <!-- 页面标题区域 -->
  <view class="header">
    <view class="title">车辆保养服务</view>
    <view class="subtitle">专业汽车保养、维修和美容服务</view>
  </view>

  <!-- 主要按钮区域 -->
  <view class="button-area">
    <view class="primary-button" bindtap="onAppointmentTap">预约服务</view>
    <view class="secondary-button" bindtap="onMembershipTap">会员充值</view>
  </view>

  <!-- 服务类别卡片 -->
  <view class="card">
    <view class="card-header">
      <view class="card-title">服务项目</view>
      <view class="view-more" bindtap="onViewAllServices">查看全部</view>
    </view>

    <view class="service-grid">
      <block wx:for="{{serviceCategories}}" wx:key="title">
        <view class="service-item" bindtap="onServiceItemTap" data-category="{{item.title}}">
          <view class="service-title">{{item.title}}</view>
          <view class="service-desc">{{item.description}}</view>
        </view>
      </block>
    </view>
    </view>

  <!-- 页脚信息 -->
  <view class="footer">
    车辆保养服务平台 © 2024
  </view>
</view>
