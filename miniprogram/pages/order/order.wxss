/* order.wxss */
page {
  padding: 0;
  margin: 0;
  background-color: #f7f8fa;
}

/* 自定义导航栏样式 */
.t-navbar {
  width: 100% !important;
  padding: 0 !important;
  margin: 0 !important;
  background-color: #fff !important;
  flex-shrink: 0;
}

/* 强制导航栏没有上边距 */
.t-navbar__content {
  padding-top: 0 !important;
}

/* 移除导航栏左侧按钮的间距 */
.t-navbar__left {
  padding-left: 0 !important;
}

/* 去除标题内边距 */
.t-navbar__title {
  font-weight: bold !important;
  font-size: 36rpx !important;
  padding: 0 !important;
  margin: 0 !important;
}

/* 覆盖可能的微信小程序安全区域设置 */
page {
  padding-top: 0 !important;
  --status-bar-height: 0px !important;
}

.status-tabs {
  background-color: #fff;
  padding: 0;
  margin-top: 20rpx; /* 导航栏向下移动 */
  box-sizing: border-box;
  width: 100%;
  z-index: 100;
  flex-shrink: 0;
}

.active-tab {
  color: #3b82f6 !important;
  font-weight: 500 !important;
}

.order-list-container {
  padding: 16rpx 30rpx;
  box-sizing: border-box;
  flex: 1;
  overflow-y: visible;
}

/* 自定义卡片样式 */
.custom-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.card-header {
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f3f4f6;
}

.card-content {
  padding: 0 24rpx;
}

.card-footer {
  padding: 24rpx;
}

/* 订单卡片样式 - 基于首页公告卡片样式 */
.order-card {
  background-color: #fff;
  border-radius: 28rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx 0 rgba(0, 0, 0, 0.06);
  padding: 20rpx;
}

.order-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 0;
  border-bottom: none;
}

.service-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(59, 130, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.icon-image {
  width: 40rpx;
  height: 40rpx;
}

.service-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-left: 16rpx;
  flex: 1;
}

.service-status {
  font-size: 24rpx;
  font-weight: 500;
  margin-left: auto;
}

.service-status.in_service,
.service-status.washing {
  color: #ff9c00;
}

.service-status.waiting {
  color: #3b82f6;
}

.service-status.completed {
  color: rgb(156, 163, 175);
}

.service-status.waiting_arrival {
  color: #9ca3af;
}

.order-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-left: 20rpx;
  margin-bottom: 12rpx;
}

.car-info {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.4;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.car-info text {
  color: #3b82f6;
  font-weight: 500;
  margin-right: 8rpx;
}

.price-info {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
  margin-left: 16rpx;
}

.order-time {
  font-size: 24rpx;
  color: #9ca3af;
  margin-left: 20rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.order-footer {
  padding: 16rpx 0 0 0;
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  margin-top: 12rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

/* Button styles for native buttons */
.action-buttons button {
  min-width: 160rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin-left: 20rpx;
  line-height: 1.5;
  display: inline-block;
}

/* Remove default button styling */
.action-buttons button::after {
  border: none;
}

/* Primary button style */
.action-buttons .primary {
  background-color: #3b82f6;
  color: #ffffff;
  border: none;
}

/* Light button style */
.action-buttons .light {
  background-color: #f5f5f5;
  color: #333333;
  border: 1rpx solid #e5e7eb;
}

/* Tabs custom styles */
.t-tabs__item {
  font-size: 32rpx !important;
  padding: 0 30rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
}

.t-tabs__item--active {
  font-weight: 500 !important;
}

.t-tabs__track {
  background-color: #3b82f6 !important;
  height: 4rpx !important;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-button {
  margin-top: 48rpx;
}

/* 自定义标签导航样式 */
.custom-tabs {
  display: flex;
  background-color: transparent;
  padding: 20rpx 40rpx;
  margin-bottom: 0rpx;
  justify-content: space-around;
  flex-shrink: 0;
}

.tab-item {
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  background-color: #f2f3f5;
  color: #666;
  min-width: 100rpx;
  text-align: center;
  transition: all 0.3s;
  margin: 0 10rpx;
}

.tab-item.active {
  background-color: #3b82f6;
  color: #fff;
  font-weight: 500;
}

/* 移除旧的tabs样式 */
.status-tabs,
.t-tabs {
  display: none;
}
