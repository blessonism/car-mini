/* membership-topup.wxss */
page {
  background-color: #f8f9ff;
}

.container {
  min-height: 100vh;
  padding: 30rpx 0;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 账户余额卡片 */
.account-card {
  margin: 30rpx 30rpx 40rpx;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #5145e5, #793aec);
  border-radius: 24rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(99, 102, 241, 0.2);
}

.account-label {
  font-size: 30rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.account-balance {
  display: flex;
  justify-content: center;
  align-items: baseline;
}

.currency {
  font-size: 40rpx;
  font-weight: 500;
  margin-right: 6rpx;
}

.amount {
  font-size: 72rpx;
  font-weight: 700;
  font-family: "DIN Condensed", sans-serif;
}

/* 会员提示横幅 */
.member-banner {
  margin: 0 30rpx 40rpx;
  padding: 20rpx 30rpx;
  background-color: #fff8e9;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  color: #d97706;
  border: 1rpx solid rgba(217, 119, 6, 0.2);
}

.banner-icon {
  margin-right: 12rpx;
  margin-bottom: -8rpx;
}

.crown-icon {
  width: 40rpx;
  height: 40rpx;
}

.banner-text {
  flex: 1;
  font-size: 28rpx;
  color: #b45309;
  font-weight: 500;
}

.banner-action {
  font-size: 26rpx;
  color: #d97706;
  font-weight: 500;
}

/* 节标题（卡片外） */
.section-header {
  display: flex;
  align-items: center;
  margin: 40rpx 40rpx 30rpx;
}

.section-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

/* 充值选项卡片 */
.topup-options-card {
  margin: 0 30rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.topup-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.option-item {
  height: 140rpx;
  background-color: #f9fafb;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 2rpx solid #f3f4f6;
  transition: all 0.3s ease;
}

.option-selected {
  background-color: rgba(219, 234, 254, 0.6);
  border-color: #3b82f6;
}

.option-amount {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
}

.option-gift {
  font-size: 24rpx;
  color: #596780;
  font-weight: 300;
}

/* 自定义金额输入卡片 */
.custom-amount-card {
  margin: 0 30rpx;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  padding: 20rpx 30rpx;
}

.custom-amount-input {
  height: 80rpx;
  width: 100%;
  font-size: 32rpx;
  color: #1f2937;
}

/* 底部支付栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: white;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  align-items: center;
  z-index: 10;
  height: 96rpx;
}

.price-area {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 28rpx;
  color: #ff4141;
  margin-right: 4rpx;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff4141;
}

.order-button {
  width: 240rpx !important;
  background-color: #3b82f6 !important;
  border-color: transparent !important;
  position: absolute !important;
  right: 30rpx !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
}

.t-button--primary::after {
  border-color: transparent !important;
}
