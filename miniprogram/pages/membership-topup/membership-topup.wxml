<!-- membership-topup.wxml -->
<view class="container">
  <!-- 账户余额卡片 -->
  <view class="account-card">
    <view class="account-label">账户余额</view>
    <view class="account-balance">
      <text class="currency">¥</text>
      <text class="amount">{{accountInfo.balance}}</text>
    </view>
  </view>

  <!-- 会员提示横幅 -->
  <view class="member-banner">
    <view class="banner-icon">
      <image src="../../assets/icons/crown_brown.png" class="crown-icon" mode="aspectFit"></image>
    </view>
    <view class="banner-text">开通会员，洗车更优惠！</view>
    <view class="banner-action" bindtap="navigateToMemberDetail">了解详情 ></view>
  </view>

  <!-- 充值金额选择 -->
  <view class="section-header">
    <text class="section-text">选择充值金额</text>
  </view>
  <view class="topup-options-card">
    <view class="topup-options">
      <view 
        class="option-item {{selectedAmountIndex === 0 ? 'option-selected' : ''}}" 
        bindtap="selectAmount" 
        data-index="0"
      >
        <view class="option-amount">¥50</view>
        <view class="option-gift">送¥5</view>
      </view>
      
      <view 
        class="option-item {{selectedAmountIndex === 1 ? 'option-selected' : ''}}" 
        bindtap="selectAmount" 
        data-index="1"
      >
        <view class="option-amount">¥100</view>
        <view class="option-gift">送¥12</view>
      </view>
      
      <view 
        class="option-item {{selectedAmountIndex === 2 ? 'option-selected' : ''}}" 
        bindtap="selectAmount" 
        data-index="2"
      >
        <view class="option-amount">¥200</view>
        <view class="option-gift">送¥30</view>
      </view>
      
      <view 
        class="option-item {{selectedAmountIndex === 3 ? 'option-selected' : ''}}" 
        bindtap="selectAmount" 
        data-index="3"
      >
        <view class="option-amount">¥300</view>
        <view class="option-gift">送¥50</view>
      </view>
      
      <view 
        class="option-item {{selectedAmountIndex === 4 ? 'option-selected' : ''}}" 
        bindtap="selectAmount" 
        data-index="4"
      >
        <view class="option-amount">¥500</view>
        <view class="option-gift">送¥100</view>
      </view>
      
      <view 
        class="option-item {{selectedAmountIndex === 5 ? 'option-selected' : ''}}" 
        bindtap="selectAmount" 
        data-index="5"
      >
        <view class="option-amount">¥1000</view>
        <view class="option-gift">送¥250</view>
      </view>
    </view>
  </view>

  <!-- 其他金额输入 -->
  <view class="section-header">
    <text class="section-text">其他金额</text>
  </view>
  <view class="custom-amount-card">
    <input 
      type="digit" 
      class="custom-amount-input" 
      placeholder="请输入充值金额 (元)" 
      value="{{customAmount}}" 
      bindinput="onCustomAmountChange" 
    />
  </view>

  <!-- 底部充值按钮 -->
  <view class="bottom-bar">    
    <t-button theme="primary" size="large" class="order-button" bindtap="confirmTopup">立即充值</t-button>
  </view>
</view> 