/* appointment-time.wxss */
.container {
  background-color: #f8f9ff;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.steps-wrapper {
  padding: 32rpx 24rpx;
  background-color: #fff;
  margin-bottom: 24rpx;
}

.appointment-content {
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 40rpx 0 24rpx;
  color: #1f2937;
}

.date-scroll {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 0;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 130rpx;
  height: 160rpx;
  margin-right: 20rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

.date-item.active {
  background: #3b82f6;
  color: white;
}

.date-day {
  font-size: 24rpx;
  margin-bottom: 4rpx;
}

.date-date {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.date-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.6);
}

.date-item.active .date-text {
  color: rgba(255, 255, 255, 0.8);
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.time-item {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.time-item.active {
  background: #3b82f6;
  color: white;
}

.time-item.disabled {
  background: #f3f4f6;
  color: #9ca3af;
  cursor: not-allowed;
}

.store-cell {
  margin-bottom: 16rpx;
  border-radius: 16rpx !important;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05) !important;
}

.store-icon-container {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(59, 130, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.store-distance {
  font-size: 26rpx;
  color: #6b7280;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 24rpx;
  background: white;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  gap: 24rpx;
  z-index: 10;
}

.btn-prev {
  flex: 1;
}

.btn-next {
  flex: 1;
} 