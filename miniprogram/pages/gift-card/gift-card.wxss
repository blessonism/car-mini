/* pages/gift-card/gift-card.wxss */

.gift-card-container {
  min-height: 100vh;
  background-color: #f6f6f6;
  padding-bottom: 120rpx;
}

/* 标签页样式 */
.tab-bar {
  display: flex;
  background-color: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  padding: 20rpx 0;
}

.tab-item.active {
  color: #07c160;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

.tab-content {
  padding: 30rpx;
}

/* 余额展示区域 */
.balance-section {
  background-color: #07c160;
  color: #fff;
  padding: 40rpx 30rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.balance-title {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.balance-amount {
  font-size: 60rpx;
  font-weight: bold;
}

/* 卡片列表 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
}

.card-list {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.card-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.card-item:last-child {
  border-bottom: none;
}

.card-info {
  flex: 1;
}

.card-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.card-amount {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.card-status {
  display: inline-block;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-bottom: 10rpx;
}

.card-status.active {
  background-color: #e7f8ef;
  color: #07c160;
}

.card-status.used {
  background-color: #f2f2f2;
  color: #999;
}

.card-status.expired {
  background-color: #fff0f0;
  color: #ff4d4f;
}

.card-expire {
  font-size: 24rpx;
  color: #999;
}

.card-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  background-color: #f7f7f7;
  border: none;
  box-sizing: border-box;
  line-height: 1.5;
  min-height: unset;
}

.use-btn {
  color: #07c160;
  border: 1rpx solid #07c160;
  background-color: #fff;
}

.use-btn[disabled] {
  color: #ccc;
  border: 1rpx solid #eee;
  background-color: #f7f7f7;
}

.share-btn {
  color: #666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  background-color: #fff;
  border-radius: 12rpx;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.primary-btn {
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
  border: none;
}

/* 使用记录 */
.usage-records {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 10rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
}

.record-description {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.record-amount.income {
  color: #07c160;
}

.record-amount.expense {
  color: #ff4d4f;
}

/* 购买礼品卡 */
.purchase-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.card-options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.card-option {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  position: relative;
}

.card-option.selected {
  border-color: #07c160;
  background-color: #f0fffa;
}

.card-option.selected::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 0 0 10rpx 0;
  background-color: #07c160;
}

.option-amount {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.option-price {
  font-size: 28rpx;
  color: #ff4d4f;
  margin-bottom: 10rpx;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
}

/* 购买数量 */
.quantity-section {
  margin-bottom: 40rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
  width: 240rpx;
  margin: 20rpx 0;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border: 1rpx solid #ddd;
  background-color: #f7f7f7;
  font-size: 36rpx;
}

.quantity-input {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-top: 1rpx solid #ddd;
  border-bottom: 1rpx solid #ddd;
}

/* 支付方式 */
.payment-section {
  margin-bottom: 40rpx;
}

.payment-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.payment-option {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  width: calc(50% - 10rpx);
  box-sizing: border-box;
}

.payment-option.selected {
  border-color: #07c160;
  background-color: #f0fffa;
}

.payment-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.payment-name {
  font-size: 28rpx;
}

/* 赠送选项 */
.gift-section {
  margin-bottom: 40rpx;
}

.gift-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.friend-input {
  margin-top: 20rpx;
}

.phone-input {
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
}

/* 订单汇总 */
.order-summary {
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.summary-label {
  color: #666;
}

.summary-value {
  font-weight: bold;
}

.summary-value.discount {
  color: #ff4d4f;
}

.summary-item.total {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.summary-item.total .summary-label,
.summary-item.total .summary-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
}

/* 底部按钮区域 */
.bottom-bar {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.total-price {
  font-size: 28rpx;
}

.total-price .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.submit-btn {
  background-color: #07c160;
  color: #fff;
  font-size: 32rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  border: none;
} 