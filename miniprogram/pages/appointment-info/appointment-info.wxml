<!-- appointment-info.wxml -->
<view class="container">

  <!-- 步骤指示器 -->
  <view class="steps-wrapper">
    <t-steps current="{{2}}" bind:change="onStepChange">
      <t-step-item title="选择服务" />
      <t-step-item title="选择时间" />
      <t-step-item title="填写信息" />
      <t-step-item title="支付确认" />
    </t-steps>
  </view>

  <!-- 填写信息表单 -->
  <view class="info-content">
    <view class="section-title">车辆信息</view>
    
    <!-- 已有车辆选择 -->
    <view class="sub-title">选择已有车辆</view>
    
    <t-radio-group value="{{selectedCarId}}" bind:change="onCarChange">
      <view class="car-card {{selectedCarId === '1' ? 'selected' : ''}}" bindtap="selectCar" data-id="1">
        <t-icon wx:if="{{selectedCarId === '1'}}" name="check-circle-filled" size="48rpx" class="check-icon" />
        <t-icon wx:else name="circle" size="48rpx" class="uncheck-icon" />
        <view class="car-info">
          <view class="car-plate">粤A12345</view>
          <view class="car-model">宝马 3系 白色</view>
        </view>
      </view>
      
      <view class="car-card {{selectedCarId === '2' ? 'selected' : ''}}" bindtap="selectCar" data-id="2">
        <t-icon wx:if="{{selectedCarId === '2'}}" name="check-circle-filled" size="48rpx" class="check-icon" />
        <t-icon wx:else name="circle" size="48rpx" class="uncheck-icon" />
        <view class="car-info">
          <view class="car-plate">粤B67890</view>
          <view class="car-model">奥迪 A4L 黑色</view>
        </view>
      </view>
    </t-radio-group>
    
    <t-button 
      theme="light" 
      icon="add" 
      block 
      size="large" 
      t-class="add-car-btn" 
      bindtap="toggleAddCarForm"
    >
      添加新车辆
    </t-button>
    
    <!-- 新车辆表单 -->
    <view class="form-card" wx:if="{{showAddCarForm}}">
      <view class="sub-title">新车辆信息</view>
      
      <t-input
        label="车牌号码"
        placeholder="请输入车牌号码"
        value="{{newCar.plate}}"
        bind:change="onInputChange"
        data-field="plate"
      />
      
      <t-input
        label="车辆品牌"
        placeholder="请选择车辆品牌"
        value="{{newCar.brand}}"
        bind:tap="showBrandPicker"
        disabled
        suffix-icon="chevron-down"
      />
      
      <t-input
        label="车辆型号"
        placeholder="请输入车型"
        value="{{newCar.model}}"
        bind:change="onInputChange"
        data-field="model"
      />
      
      <t-input
        label="车身颜色"
        placeholder="请选择车身颜色"
        value="{{newCar.color}}"
        bind:tap="showColorPicker"
        disabled
        suffix-icon="chevron-down"
      />
    </view>
    
    <!-- 备注信息 -->
    <view class="section-title" style="margin-top:32rpx;">备注信息</view>
    <t-textarea
      placeholder="如有特殊需求，请在此备注"
      maxlength="{{200}}"
      indicator
      autosize
      value="{{remark}}"
      bind:change="onRemarkChange"
      t-class="remark-textarea"
    />
  </view>
  
  <!-- 品牌选择器 -->
  <t-picker
    visible="{{brandPickerVisible}}"
    title="选择车辆品牌"
    cancelBtn="取消"
    confirmBtn="确认"
    bindcancel="hideBrandPicker"
    bindconfirm="onBrandConfirm"
  >
    <t-picker-item options="{{brandOptions}}"></t-picker-item>
  </t-picker>
  
  <!-- 颜色选择器 -->
  <t-picker
    visible="{{colorPickerVisible}}"
    title="选择车身颜色"
    cancelBtn="取消"
    confirmBtn="确认"
    bindcancel="hideColorPicker"
    bindconfirm="onColorConfirm"
  >
    <t-picker-item options="{{colorOptions}}"></t-picker-item>
  </t-picker>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <t-button theme="light" size="large" class="btn-prev" bindtap="prevStep">上一步</t-button>
    <t-button theme="primary" size="large" class="btn-next" bindtap="nextStep">下一步</t-button>
  </view>
</view> 