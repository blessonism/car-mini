/* order-detail.wxss */
.container {
  background-color: #f8f9ff;
  min-height: 100vh;
  padding-top: 20rpx;
  padding-bottom: 120rpx;
}

/* 订单头部卡片 */
.order-header-card {
  position: relative;
  background-color: white;
  padding: 40rpx 40rpx 50rpx;
  margin: 0 30rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-radius: 16rpx;
}

.order-number {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.order-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.status-tag {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  background-color: #e6f7ff;
  color: #3b82f6;
  font-size: 26rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
}

/* 时间线卡片 */
.timeline-card {
  background-color: white;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-radius: 16rpx;
  margin: 0 30rpx 30rpx;
}

.timeline {
  position: relative;
  padding: 10rpx 0;
}

.timeline-item {
  position: relative;
  padding-left: 60rpx;
  margin-bottom: 50rpx;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-icon {
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #fff;
  border: 1rpx solid #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.timeline-icon.completed {
  background-color: #07c160;
  border-color: #07c160;
}

.timeline-icon.processing {
  background-color: #3b82f6;
  border-color: #3b82f6;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.5);
  }
  70% {
    box-shadow: 0 0 0 10px rgba(59, 130, 246, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(59, 130, 246, 0);
  }
}

.check-icon,
.process-icon {
  color: white;
}

.timeline-line {
  position: absolute;
  top: 40rpx;
  left: 20rpx;
  width: 1rpx;
  height: calc(100% + 10rpx);
  background-color: #e8e8e8;
  z-index: 1;
}

.timeline-content {
  padding-bottom: 10rpx;
}

.timeline-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 26rpx;
  color: #999;
}

/* 服务中的文本样式增强 */
.timeline-item .timeline-title {
  transition: all 0.3s;
}

/* 信息卡片样式 */
.info-card {
  margin: 30rpx 30rpx;
  padding: 40rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  color: #666;
  width: 140rpx;
  font-weight: normal;
}

.info-value {
  color: #333;
  font-weight: 500;
  flex: 1;
  text-align: right;
}

.phone-number {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.call-icon {
  margin-left: 20rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: #e6f7ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remark-text {
  color: #666;
  font-weight: normal;
  line-height: 1.4;
}

.price-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #eee;
}

.price-value {
  color: #f5222d;
  font-weight: 600;
  font-size: 34rpx;
}

/* 底部导航 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  font-size: 28rpx;
  color: #666;
}
