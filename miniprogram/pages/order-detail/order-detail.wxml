<!-- order-detail.wxml -->
<view class="container">
  <!-- 订单头部卡片 -->
  <view class="order-header-card">
    <view class="order-number">订单号: {{orderInfo.orderNo}}</view>
    <view class="order-title">{{orderInfo.services[0].name}}</view>
    <view class="status-tag">{{orderInfo.statusText}}</view>
  </view>
  
  <!-- 订单进度时间线 -->
  <view class="timeline-card">
    <view class="timeline">
      <view class="timeline-item" wx:for="{{orderInfo.steps}}" wx:key="index">
        <view class="timeline-icon {{item.status === 'finish' ? 'completed' : item.status === 'process' ? 'processing' : ''}}">
          <view wx:if="{{item.status === 'finish'}}" class="check-icon">
            <t-icon name="check" size="28rpx" />
          </view>
          <view wx:elif="{{item.status === 'process'}}" class="process-icon">
            <t-icon name="refresh" size="28rpx" />
          </view>
        </view>
        <view class="timeline-content">
          <view class="timeline-title">{{item.title}}</view>
          <view class="timeline-time">{{item.time}}</view>
        </view>
        <view class="timeline-line" wx:if="{{index < orderInfo.steps.length - 1}}"></view>
      </view>
    </view>
  </view>
  
  <!-- 客户和车辆信息 -->
  <view class="info-card">
    <view class="card-title">客户和车辆信息</view>
    <view class="info-row">
      <view class="info-label">客户姓名</view>
      <view class="info-value">{{orderInfo.customer.name}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">联系电话</view>
      <view class="info-value phone-number">
        {{orderInfo.contactPhone}}
        <view class="call-icon" bindtap="callPhone">
          <t-icon name="call" size="40rpx" color="#3b82f6" />
        </view>
      </view>
    </view>
    <view class="info-row">
      <view class="info-label">车型信息</view>
      <view class="info-value">{{orderInfo.carInfo.brand}} {{orderInfo.carInfo.model}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">车牌号码</view>
      <view class="info-value">{{orderInfo.carInfo.plate}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">车身颜色</view>
      <view class="info-value">{{orderInfo.carInfo.color}}</view>
    </view>
  </view>
  
  <!-- 服务详情 -->
  <view class="info-card">
    <view class="card-title">服务详情</view>
    <view class="info-row">
      <view class="info-label">服务项目</view>
      <view class="info-value">{{orderInfo.services[0].name}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">预约时间</view>
      <view class="info-value">{{orderInfo.appointmentTime}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">服务技师</view>
      <view class="info-value">{{orderInfo.technician}}</view>
    </view>
    <view class="info-row" wx:if="{{orderInfo.remark}}">
      <view class="info-label">客户备注</view>
      <view class="info-value remark-text">{{orderInfo.remark}}</view>
    </view>
    <view class="info-row">
      <view class="info-label">支付方式</view>
      <view class="info-value">{{orderInfo.paymentMethod}}</view>
    </view>
    <view class="info-row price-row">
      <view class="info-label">支付金额</view>
      <view class="info-value price-value">¥{{orderInfo.totalAmount}}</view>
    </view>
  </view>
</view> 