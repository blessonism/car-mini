/* 所有样式都由 Tailwind CSS 类处理 */

/* 自定义背景颜色 */
.bg-custom-light {
  background-color: rgb(248, 249, 255) !important;
}

/* 一些额外的工具类，用于适配特定场景 */
.w-18 {
  width: 140rpx;
}

.h-18 {
  height: 140rpx;
}

.w-10 {
  width: 80rpx;
}

.h-10 {
  height: 80rpx;
}

/* 搜索框自定义样式 */
.search-custom {
  border-radius: 16rpx !important;
  overflow: hidden;
}

/* 纯白按钮样式 */
.btn-pure-white {
  background-color: #ffffff !important;
  color: var(--tw-blue-500) !important;
  border: none !important;
  font-weight: 600 !important;
  font-size: 28rpx !important;
}

.search-input {
  font-size: 28rpx !important;
}

/* 直接定位到TDesign搜索框内部元素 */
.t-search__input-box {
  background-color: rgba(255, 255, 255, 0.1) !important;
  border: none !important;
}

/* 搜索图标颜色 */
.t-search__input-box .t-icon {
  color: white !important;
}

/* 搜索框内的文本颜色 */
.t-search__input-box .t-input__keyword {
  color: white !important;
}

.t-search__input-box .t-icon {
  font-size: 32rpx !important;
  margin-right: 12rpx;
}

.t-search__input .t-input__placeholder,
.t-search__input .t-input__control {
  font-size: 26rpx !important;
}

/* 搜索框样式 - 调整圆角和边框 */
.t-search__input-box {
  border-radius: 20rpx !important;
  border: 2rpx solid transparent !important;
  transition: all 0.2s ease-in-out;
}

/* 搜索框占位符文本颜色 */
.t-search__placeholder {
  color: rgba(255, 255, 255, 0.8) !important;
}

/* 渐变背景 */
.bg-gradient-to-r {
  background-image: linear-gradient(to right, var(--tw-gradient-stops));
}

.from-blue-500 {
  --tw-gradient-from: #3b82f6;
  --tw-gradient-stops:
    var(--tw-gradient-from), var(--tw-gradient-to, rgba(59, 130, 246, 0));
}

.to-blue-700 {
  --tw-gradient-to: #1d4ed8;
}

.from-blue-400 {
  --tw-gradient-from: #60a5fa;
  --tw-gradient-stops:
    var(--tw-gradient-from), var(--tw-gradient-to, rgba(96, 165, 250, 0));
}

.to-blue-600 {
  --tw-gradient-to: #2563eb;
}

/* 空间间隔 */
.space-x-3 > view:not(:first-child) {
  margin-left: 0.75rem;
}

.space-x-2 > view:not(:first-child) {
  margin-left: 0.5rem;
}
