/* pages/appointment-payment/appointment-payment.wxss */
page {
  background-color: #f8f9ff;
}

.container {
  background-color: #f8f9ff !important;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 服务详情卡片 */
.service-card {
  background-color: #fff;
  margin: 40rpx;
  padding: 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.service-info {
  display: flex;
  align-items: center;
}

.service-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 12rpx;
  background-color: #e6f2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.service-icon t-icon {
  color: #3b82f6;
}

.service-details {
  flex: 1;
}

.service-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.service-meta {
  display: flex;
  align-items: center;
  color: #666;
}

.service-time,
.service-price {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-right: 30rpx;
}

/* 节标题（卡片外） */
.section-header {
  display: flex;
  align-items: center;
  margin: 40rpx 50rpx 35rpx 40rpx;
}

.section-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

/* 卡片通用样式 */
.info-card,
.coupon-card,
.payment-card,
.price-card {
  background-color: rgba(255, 255, 255, 0.85);
  margin: 0 40rpx 40rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

/* 预约信息项目 */
.appointment-item {
  display: flex;
  padding: 30rpx;
  align-items: center;
}

.item-icon {
  width: 90rpx;
  height: 90rpx;
  background-color: rgba(59, 130, 246, 0.1);
  display: flex;
  border-radius: 24rpx;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.item-icon-image {
  width: 40rpx;
  height: 40rpx;
}

.item-content {
  flex: 1;
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.item-value {
  font-size: 28rpx;
  color: #666;
}

.item-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 优惠券卡片 */
.coupon-card {
  padding: 0;
}

.coupon-content {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.coupon-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 65, 65, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.coupon-info {
  flex: 1;
}

.coupon-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.coupon-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 4rpx;
}

.coupon-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #999;
  margin-right: 24rpx;
}

.coupon-value.active {
  color: #ff4141;
}

.right-arrow {
  display: flex;
  align-items: center;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 支付方式 */
.payment-outer-card {
  margin: 0 40rpx 40rpx;
  background-color: rgb(255, 255, 255) !important;
  border-radius: 16rpx;
  box-shadow: 0 0 12rpx 4rpx rgba(0, 0, 0, 0.05);
  padding: 24rpx;
  overflow: hidden;
}

.payment-wrapper {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.payment-card {
  margin-bottom: 26rpx;
  margin-left: 16rpx;
  margin-right: 16rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 35rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  border: 1rpx solid rgba(241, 243, 246, 1);
  transition: all 0.3s ease;
}

.payment-card:last-child {
  margin-bottom: 0;
}

.payment-selected {
  border: 2rpx solid rgba(59, 130, 246, 0.3);
  background-color: #f0f7ff;
}

.payment-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.payment-icon-box {
  width: 90rpx;
  height: 90rpx;
  border-radius: 24rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  box-shadow: 0 1rpx 4rpx 1rpx rgba(0, 0, 0, 0.05);
}

.payment-icon {
  width: 32rpx;
  height: 32rpx;
}

.payment-icon-lg {
  width: 40rpx;
  height: 40rpx;
}

.payment-info {
  flex: 1;
}

.payment-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #333;
  margin-bottom: 6rpx;
}

.payment-desc {
  font-size: 26rpx;
  color: #596780;
}

/* 单选圆点样式 */
.radio-outer {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  background-color: #fff;
}

.radio-outer-selected {
  border-color: #3b82f6;
}

.radio-inner {
  width: 0;
  height: 0;
  border-radius: 50%;
  background-color: #3b82f6;
  transition: all 0.2s ease;
}

.radio-inner-selected {
  width: 24rpx;
  height: 24rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: rgba(240, 240, 240, 0.6);
  margin: 0 30rpx;
}

/* 价格明细 */
.price-card {
  padding: 30rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.price-label {
  font-size: 28rpx;
  color: #666;
}

.price-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.price-discount {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 500;
}

.price-item.total {
  margin-top: 20rpx;
  margin-bottom: 0;
}

.price-item.total .price-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.price-total {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: 600;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 30rpx;
  background: white;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  align-items: center;
  z-index: 10;
}

.price-area {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.price-area .price-label {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
  margin-right: 4rpx;
}

.price-area .price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.discount-hint {
  font-size: 24rpx;
  color: #596780;
  margin-top: 8rpx;
}

.pay-button {
  width: 240rpx !important;
  background-color: #3b82f6 !important;
  border-color: transparent !important;
}

.t-button--primary::after {
  border-color: transparent !important;
}

/* 图标样式 */
.base-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.sm-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}
