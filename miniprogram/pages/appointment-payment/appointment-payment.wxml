<!-- pages/appointment-payment/appointment-payment.wxml -->
<view class="container">
  <!-- 服务信息卡片 -->
  <view class="service-card">
    <view class="service-info">
      <view class="service-icon">
        <t-icon name="car" size="48rpx" />
      </view>
      <view class="service-details">
        <view class="service-name">标准洗车</view>
        <view class="service-meta">
          <view class="service-time">
            <image src="../../assets/icons/clock.png" class="sm-icon" mode="aspectFit"></image>
            <text>30分钟</text>
          </view>
          <view class="service-price">
            <image src="../../assets/icons/price.png" class="base-icon" mode="aspectFit"></image>
            <text>¥{{servicePrice}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 预约信息 -->
  <view class="section-header">
    <text class="section-text">预约信息</text>
  </view>
  <view class="info-card">
    <view class="appointment-item">
      <view class="item-icon">
        <image src="../../assets/icons/calendar.png" class="item-icon-image" mode="aspectFit"></image>
      </view>
      <view class="item-content">
        <view class="item-title">预约时间</view>
        <view class="item-value">{{date}} ({{day}}) {{time}}</view>
      </view>
    </view>
    
    <view class="divider"></view>
    
    <view class="appointment-item">
      <view class="item-icon">
        <image src="../../assets/icons/home-active.png" class="item-icon-image" mode="aspectFit"></image>
      </view>
      <view class="item-content">
        <view class="item-title">门店信息</view>
        <view class="item-value">车友养护中心 (城南店)</view>
        <view class="item-desc">成都市高新区天府大道1234号</view>
      </view>
    </view>
  </view>

  <!-- 优惠券区域 -->
  <view class="section-header">
    <text class="section-text">优惠券</text>
  </view>
  <view class="coupon-card" bindtap="showCouponSelector">
    <view class="coupon-content">
      <view class="coupon-icon">
        <image src="../../assets/icons/coupon-red.png" class="item-icon-image" mode="aspectFit"></image>
      </view>
      <view class="coupon-info">
        <view class="coupon-title">优惠券</view>
        <view class="coupon-desc">2张可用</view>
      </view>
      <view class="coupon-value {{selectedCouponIndex !== -1 ? 'active' : ''}}">
        {{selectedCouponIndex !== -1 ? '-¥' + couponDiscount : '未使用'}}
      </view>
      <view class="right-arrow">
        <image src="../../assets/icons/arrow-right.png" class="arrow-icon" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="section-header">
    <text class="section-text">支付方式</text>
  </view>
  <view class="payment-outer-card">
    <view class="payment-wrapper">
      <!-- 微信支付 -->
      <view class="payment-card {{selectedPayment === 'wechat' ? 'payment-selected' : ''}}" 
            bindtap="selectPayment" data-payment="wechat">
        <view class="payment-content">
          <view class="payment-icon-box">
            <image src="../../assets/icons/wechat.png" class="payment-icon" mode="aspectFit"></image>
          </view>
          <view class="payment-info">
            <view class="payment-name">微信支付</view>
            <view class="payment-desc">微信账号直接支付</view>
          </view>
        </view>
        <view class="radio-outer {{selectedPayment === 'wechat' ? 'radio-outer-selected' : ''}}">
          <view class="radio-inner {{selectedPayment === 'wechat' ? 'radio-inner-selected' : ''}}"></view>
        </view>
      </view>
      
      <!-- 余额支付 -->
      <view class="payment-card {{selectedPayment === 'balance' ? 'payment-selected' : ''}}" 
            bindtap="selectPayment" data-payment="balance">
        <view class="payment-content">
          <view class="payment-icon-box">
            <image src="../../assets/icons/wallet-red.png" class="payment-icon" mode="aspectFit"></image>
          </view>
          <view class="payment-info">
            <view class="payment-name">余额支付</view>
            <view class="payment-desc">账户余额直接支付</view>
          </view>
        </view>
        <view class="radio-outer {{selectedPayment === 'balance' ? 'radio-outer-selected' : ''}}">
          <view class="radio-inner {{selectedPayment === 'balance' ? 'radio-inner-selected' : ''}}"></view>
        </view>
      </view>
      
      <!-- 会员卡 -->
      <view class="payment-card {{selectedPayment === 'card' ? 'payment-selected' : ''}}" 
            bindtap="selectPayment" data-payment="card">
        <view class="payment-content">
          <view class="payment-icon-box">
            <image src="../../assets/icons/vip_card.png" class="payment-icon-lg" mode="aspectFit"></image>
          </view>
          <view class="payment-info">
            <view class="payment-name">会员卡</view>
            <view class="payment-desc">会员卡余额支付</view>
          </view>
        </view>
        <view class="radio-outer {{selectedPayment === 'card' ? 'radio-outer-selected' : ''}}">
          <view class="radio-inner {{selectedPayment === 'card' ? 'radio-inner-selected' : ''}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="section-header">
    <text class="section-text">价格明细</text>
  </view>
  <view class="price-card">
    <view class="price-item">
      <view class="price-label">服务费用</view>
      <view class="price-value">¥{{servicePrice}}</view>
    </view>
    
    <view class="price-item">
      <view class="price-label">优惠券</view>
      <view class="price-discount">-¥{{couponDiscount}}</view>
    </view>
    
    <view class="price-item">
      <view class="price-label">会员折扣</view>
      <view class="price-discount">-¥{{memberDiscount}}</view>
    </view>
    
    <view class="divider"></view>
    
    <view class="price-item total">
      <view class="price-label">订单总价</view>
      <view class="price-total">¥{{totalPrice}}</view>
    </view>
  </view>

  <!-- 底部支付栏 -->
  <view class="bottom-bar">
    <view class="price-area">
      <view class="price-row">
        <text class="price-label">¥</text>
        <text class="price-value">{{totalPrice}}</text>
      </view>
      <text class="discount-hint">已优惠¥{{couponDiscount + memberDiscount}}</text>
    </view>
    <t-button theme="primary" size="large" class="pay-button" bindtap="submitPayment">立即支付</t-button>
  </view>
</view> 