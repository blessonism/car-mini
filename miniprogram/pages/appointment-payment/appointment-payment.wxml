<!-- pages/appointment-payment/appointment-payment.wxml -->
<view class="container">
  <!-- Steps component -->
  <view class="steps-container">
    <t-steps current="{{currentStep}}">
      <t-step-item wx:for="{{steps}}" wx:key="index" title="{{item.title}}" status="{{item.status}}" />
    </t-steps>
  </view>
  
  <!-- Appointment Info Card -->
  <view class="info-card">
    <view class="card-header">预约信息</view>
    <view class="info-row">
      <text class="info-label">门店</text>
      <text class="info-value">{{appointmentInfo.storeName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">时间</text>
      <text class="info-value">{{appointmentInfo.appointmentTime}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">车型</text>
      <text class="info-value">{{appointmentInfo.carModel}}</text>
    </view>
  </view>
  
  <!-- Service Card -->
  <view class="service-card">
    <view class="card-header">服务项目</view>
    <view class="service-item">
      <view class="service-info">
        <view class="service-name">{{serviceInfo.name}}</view>
        <view class="service-desc">{{serviceInfo.description}}</view>
      </view>
      <view class="service-price">¥{{serviceInfo.price}}</view>
    </view>
  </view>
  
  <!-- Payment Method Card -->
  <view class="payment-card">
    <view class="card-header">支付方式</view>
    <view 
      class="payment-method {{item.selected ? 'selected' : ''}}" 
      wx:for="{{paymentMethods}}" 
      wx:key="id" 
      bindtap="selectPaymentMethod"
      data-index="{{index}}"
    >
      <view class="payment-icon">
        <t-icon name="{{item.icon}}" size="48rpx" />
      </view>
      <view class="payment-info">
        <text class="payment-name">{{item.name}}</text>
        <text class="payment-balance" wx:if="{{item.balance !== null}}">余额: ¥{{item.balance}}</text>
      </view>
      <view class="payment-select-icon">
        <t-icon name="{{item.selected ? 'check-circle-filled' : 'circle'}}" color="{{item.selected ? '#0052d9' : '#ddd'}}" />
      </view>
    </view>
  </view>
  
  <!-- Coupon Card -->
  <view class="coupon-card" bindtap="showCouponSelector">
    <view class="card-header">优惠券</view>
    <view class="coupon-selector">
      <view class="coupon-info" wx:if="{{selectedCouponIndex !== -1}}">
        <view class="coupon-name">{{coupons[selectedCouponIndex].name}}</view>
        <view class="coupon-amount">-¥{{coupons[selectedCouponIndex].amount}}</view>
      </view>
      <view class="coupon-info" wx:else>
        <view class="coupon-placeholder">选择优惠券</view>
      </view>
      <view class="coupon-arrow">
        <t-icon name="chevron-right" />
      </view>
    </view>
  </view>
  
  <!-- Payment Summary -->
  <view class="payment-summary">
    <view class="summary-row">
      <text>服务金额</text>
      <text>¥{{paymentSummary.serviceAmount}}</text>
    </view>
    <view class="summary-row" wx:if="{{paymentSummary.discount > 0}}">
      <text>优惠金额</text>
      <text class="discount-amount">-¥{{paymentSummary.discount}}</text>
    </view>
    <view class="summary-total">
      <text>实付金额</text>
      <text class="total-amount">¥{{paymentSummary.totalAmount}}</text>
    </view>
  </view>
  
  <!-- Bottom Bar -->
  <view class="bottom-bar">
    <view class="price-container">
      <text class="price-label">实付金额:</text>
      <text class="price-value">¥{{paymentSummary.totalAmount}}</text>
    </view>
    <view class="pay-button" bindtap="submitPayment">立即支付</view>
  </view>
  
  <!-- Coupon Popup -->
  <t-popup visible="{{showCouponPopup}}" bind:visible-change="closeCouponPopup" placement="bottom">
    <view class="coupon-popup">
      <view class="popup-header">
        <text>选择优惠券</text>
        <t-icon name="close" bindtap="closeCouponPopup" />
      </view>
      
      <view class="coupon-list">
        <view 
          class="coupon-item {{selectedCouponIndex === index ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}" 
          wx:for="{{coupons}}" 
          wx:key="id"
          bindtap="selectCoupon"
          data-index="{{index}}"
        >
          <view class="coupon-left">
            <view class="coupon-amount">¥{{item.amount}}</view>
            <view class="coupon-condition">{{item.condition}}</view>
          </view>
          <view class="coupon-right">
            <view class="coupon-name">{{item.name}}</view>
            <view class="coupon-date">{{item.validity}}</view>
            <view class="coupon-status" wx:if="{{item.disabled}}">不可用</view>
          </view>
          <view class="coupon-select" wx:if="{{!item.disabled}}">
            <t-icon name="{{selectedCouponIndex === index ? 'check-circle-filled' : 'circle'}}" color="{{selectedCouponIndex === index ? '#0052d9' : '#ddd'}}" size="40rpx" />
          </view>
        </view>
        
        <!-- No coupon option -->
        <view 
          class="coupon-item no-coupon {{selectedCouponIndex === -1 ? 'selected' : ''}}" 
          bindtap="clearCoupon"
        >
          <view class="no-coupon-text">不使用优惠券</view>
          <view class="coupon-select">
            <t-icon name="{{selectedCouponIndex === -1 ? 'check-circle-filled' : 'circle'}}" color="{{selectedCouponIndex === -1 ? '#0052d9' : '#ddd'}}" size="40rpx" />
          </view>
        </view>
      </view>
    </view>
  </t-popup>
</view> 