/* appointment-service.wxss */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 服务详情卡片 */
.service-card {
  background-color: #fff;
  margin: 30rpx;
  padding: 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.service-info {
  display: flex;
  align-items: center;
}

.service-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background-color: #e6f2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.service-icon t-icon {
  color: #3b82f6;
}

.service-details {
  flex: 1;
}

.service-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.service-meta {
  display: flex;
  align-items: center;
  color: #666;
}

.service-time,
.service-price {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  margin-right: 30rpx;
}

.service-time t-icon,
.service-price t-icon {
  margin-right: 8rpx;
}

/* 各部分通用样式 */
.section {
  background-color: #fff;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
  color: #333;
}

.section-icon {
  margin-right: 16rpx;
  color: #3b82f6;
}

/* 服务方式选择 */
.service-type-options {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.service-type-option {
  width: 48%;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 30rpx;
  position: relative;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.service-type-option.selected {
  border-color: #3b82f6;
  background-color: #e6f2ff;
}

.option-icon {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}

.service-type-option.selected .option-icon t-icon {
  color: #3b82f6;
}

.option-name {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  color: #333;
}

.option-desc {
  font-size: 24rpx;
  color: #666;
}

/* 车辆选择区域 */
.car-select-area {
  margin-top: 20rpx;
}

.car-selection-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.car-list {
  margin-bottom: 20rpx;
}

.car-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.car-item.selected {
  border-color: #3b82f6;
  background-color: #e6f2ff;
}

.car-info {
  flex: 1;
  margin-left: 20rpx;
}

.car-model {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.car-plate {
  font-size: 26rpx;
  color: #666;
}

.edit-icon {
  color: #3b82f6;
  padding: 10rpx;
}

.add-car-button {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 30rpx;
  text-align: center;
  color: #3b82f6;
  font-size: 30rpx;
}

/* 备注输入框 */
.remark-textarea {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx !important;
  min-height: 160rpx;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 30rpx;
  background: white;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  align-items: center;
  z-index: 10;
}

.price-area {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 28rpx;
  color: #ff4141;
  margin-right: 4rpx;
}

.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff4141;
}

.order-button {
  width: 240rpx !important;
}
