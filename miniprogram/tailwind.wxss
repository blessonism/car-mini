}
.rounded-full {
  border-radius: 9999rpx;
}

.rounded-b-lg {
  border-radius: 0 0 16rpx 16rpx;
}
.rounded-b-xl {
  border-radius: 0 0 24rpx 24rpx;
}
.rounded-b-2xl {
